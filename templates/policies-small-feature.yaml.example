# ADLC5 — standard feature autopilot profile (dogfood reference)
# Copy to .adlc5/{feature}/policies.yaml and merge with defaults.

defaults:
  interaction_mode: autonomous
  execution_mode: parallel
  verify_policy: auto
  integrate_policy: auto

autopilot:
  endpoint: pr_ready
  interaction_mode: autonomous
  profile: standard
  wall_clock_cap_minutes: 120
  max_iterations: 80
  consecutive_failure_tripwire: 3

  quality_gates:
    coverage_min: 70
    lint_errors_max: 0

  retry_budgets:
    implementation_per_story: 2
    verification_per_story: 2
    integration_total: 1

  hard_escalation:
    - security_critical
    - contradictory_spec
    - unapproved_verifier_waiver

# Review must be independent of the coding session.
persona_mode:
  fresh_subagent_per_persona: true
  verifier_different_model: false

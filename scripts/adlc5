#!/usr/bin/env python3
"""ADLC5 kernel façade — deterministic ops via existing scripts.

Usage:
  ./scripts/adlc5 [--version] [-h|--help]
  ./scripts/adlc5 version
  ./scripts/adlc5 gate --feature NAME [--gate GATE] [--workspace DIR] ...
  ./scripts/adlc5 pack --feature NAME --story-id ID [--workspace DIR] [--persona coder|tester]
  ./scripts/adlc5 clarity <file_path> [--step-id ID]
  ./scripts/adlc5 phase --feature NAME [--workspace DIR] [--target PHASE_ID]
  ./scripts/adlc5 pilot --feature NAME [--workspace DIR] [--record-result pass|fail]
  ./scripts/adlc5 state get --feature NAME [--workspace DIR]
  ./scripts/adlc5 state set --feature NAME [--workspace DIR] (--patch JSON | --file PATH) [--replace] [--dry-run]
  ./scripts/adlc5 anchors lock|check --feature NAME [--workspace DIR]
  ./scripts/adlc5 repo-spec init|reconcile|validate [--workspace DIR]
  ./scripts/adlc5 repo-index build|refresh|check [--workspace DIR]
  ./scripts/adlc5 resolve-model --tier TIER [--platform NAME] ...
  ./scripts/adlc5 cleanup-features --workspace DIR ...
  ./scripts/adlc5 feature summarize --feature-dir PATH [--workspace DIR] [--dry-run]
  ./scripts/adlc5 patterns lookup --tags TAG[,TAG...] [--group GROUP] ...

Stdout: pass-through from underlying tools (JSON where those tools emit JSON).
Exit: pass-through from underlying tools; usage/validation errors → 2.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SCRIPTS = ROOT / "scripts"
VERSION_FILE = ROOT / "core" / "VERSION"

sys.path.insert(0, str(SCRIPTS))
from lib.package_guard import check_workspace, resolve_workspace  # noqa: E402
from lib.state_v2 import (  # noqa: E402
    feature_state_path,
    load_feature_state,
    set_feature_state,
)

COMMANDS = {
    "transition": "Validated canonical next-step transition",
    "evidence": "Run checks and record review/approval evidence",
    "gate": "Evaluate delivery/lifecycle gates (→ check-gates.py)",
    "pack": "Generate story context pack (→ generate-pack.sh)",
    "clarity": "Score a spec/design file (→ clarity-score.py)",
    "phase": "Inspect legacy phase suggestion; canonical progression uses transition",
    "pilot": "One autopilot iteration (→ pilot-autopilot.sh)",
    "state": "Read/patch metadata; audited repair cannot certify completion",
    "anchors": "Lock/check acceptance anchors (lock applies the validated state patch)",
    "repo-spec": "Initialize/validate tracked repository constitution files",
    "repo-index": "Build/refresh/check generated repository intelligence",
    "resolve-model": "Resolve tier → host model ID (→ resolve-model.sh)",
    "cleanup-features": "Dry-run/archive/delete aged .adlc5/{feature}/ (default: dry-run archive → _archive/)",
    "feature": "Feature helpers (summarize → OKF FEATURE.md)",
    "usage": "Record/summarize/fleet-roll-up model + token usage (→ memory/usage-ledger.py)",
    "patterns": "OKF catalog lookup — ids/paths only (→ patterns/lookup.sh)",
    "spec-lint": "Lint code-spec YAML frontmatter (→ tasks/spec-lint.py)",
    "verify-story": "Deterministic per-story pre-check before @assure-verifier (→ verify-story.py)",
    "version": "Print ADLC5 semver from core/VERSION",
}


def read_version() -> str:
    if VERSION_FILE.is_file():
        return VERSION_FILE.read_text(encoding="utf-8").strip()
    return "0.0.0"


def usage(stream=sys.stdout) -> None:
    print(
        f"""adlc5 {read_version()} — fat kernel façade

Usage:
  ./scripts/adlc5 [--version] [-h|--help]
  ./scripts/adlc5 <command> [args...]

Commands:
  gate           {COMMANDS['gate']}
  pack           {COMMANDS['pack']}
  clarity        {COMMANDS['clarity']}
  phase          {COMMANDS['phase']}
  pilot          {COMMANDS['pilot']}
  state get|set  {COMMANDS['state']}
  anchors lock|check {COMMANDS['anchors']}
  repo-spec init|reconcile|validate {COMMANDS['repo-spec']}
  repo-index build|refresh|check {COMMANDS['repo-index']}
  resolve-model  {COMMANDS['resolve-model']}
  cleanup-features  {COMMANDS['cleanup-features']}
  feature summarize {COMMANDS['feature']}
  usage record|summary {COMMANDS['usage']}
  patterns lookup  {COMMANDS['patterns']}
  spec-lint      {COMMANDS['spec-lint']}
  verify-story   {COMMANDS['verify-story']}
  version        {COMMANDS['version']}

Examples:
  ./scripts/adlc5 gate --feature NAME --gate pr-ready --workspace .
  ./scripts/adlc5 pack --feature NAME --story-id US-1 --workspace .
  ./scripts/adlc5 clarity path/to/spec.md --step-id specify
  ./scripts/adlc5 phase --feature NAME --workspace .
  ./scripts/adlc5 pilot --feature NAME --workspace .
  ./scripts/adlc5 state get --feature NAME --workspace .
  ./scripts/adlc5 state set --feature NAME --workspace . --patch '{{"scope":{{"type":"increment"}}}}'
  ./scripts/adlc5 anchors lock --feature NAME --workspace .
  ./scripts/adlc5 repo-spec init --workspace .
  ./scripts/adlc5 repo-spec reconcile --workspace .
  ./scripts/adlc5 repo-index refresh --workspace .
  ./scripts/adlc5 resolve-model --tier balanced --platform cursor
  ./scripts/adlc5 cleanup-features --workspace . --status complete --older-than 90 --dry-run
  ./scripts/adlc5 cleanup-features --workspace . --status complete --older-than 90 --archive
  ./scripts/adlc5 feature summarize --feature-dir .adlc5/_archive/NAME-YYYYMMDD --workspace .
  ./scripts/adlc5 usage record --feature NAME --workspace . --model-id claude-sonnet-5 \\
    --input-tokens 1000 --output-tokens 200 --cache-read-tokens 900
  ./scripts/adlc5 usage summary --feature NAME --workspace . --format markdown
  ./scripts/adlc5 usage fleet --workspace . --format markdown
  ./scripts/adlc5 patterns lookup --tags latency,extensibility --limit 3
  ./scripts/adlc5 spec-lint --feature NAME --workspace .
  ./scripts/adlc5 verify-story --feature NAME --story-id US-1 --workspace .
  ./scripts/adlc5 version

Underlying tools keep their own flags; unknown args are forwarded.
Phase is legacy suggest-only; canonical progression uses transition TARGET.
See: docs/ADLC5-kernel.md
""",
        file=stream,
        end="",
    )


def run(cmd: list[str], *, env: dict | None = None) -> int:
    # Inherit the caller's cwd: relative consumer paths (--workspace ., --file x)
    # must resolve against the consumer, never against the framework/package dir.
    # Every delegated script locates itself via absolute paths.
    proc = subprocess.run(cmd, env=env or os.environ.copy())
    return int(proc.returncode)


def _workspace_args(args: list[str]) -> list[str | None]:
    """Every workspace value on the command line (argparse and the shell scripts take the last
    one, abbreviations included), so all of them must pass the guard. [None] = default (cwd)."""
    found: list[str | None] = []
    for i, arg in enumerate(args):
        flag, eq, value = arg.partition("=")
        if len(flag) < 4 or not flag.startswith("--") or not "--workspace".startswith(flag):
            continue
        if eq:
            found.append(value)
        elif i + 1 < len(args):
            found.append(args[i + 1])
    return found or [None]


def require_exec(script: Path) -> int | None:
    if not script.is_file():
        print(f"ERROR: missing: {script}", file=sys.stderr)
        return 2
    if not os.access(script, os.X_OK) and script.suffix == ".sh":
        print(f"ERROR: not executable: {script}", file=sys.stderr)
        return 2
    return None


def cmd_gate(args: list[str]) -> int:
    script = SCRIPTS / "check-gates.py"
    return run([sys.executable, str(script), *args])


def cmd_spec_lint(args: list[str]) -> int:
    script = SCRIPTS / "tasks" / "spec-lint.py"
    return run([sys.executable, str(script), *args])


def cmd_verify_story(args: list[str]) -> int:
    script = SCRIPTS / "verify-story.py"
    return run([sys.executable, str(script), *args])


def cmd_pack(args: list[str]) -> int:
    script = ROOT / "scripts" / "memory" / "generate-pack.sh"
    err = require_exec(script)
    if err is not None:
        return err
    return run(["bash", str(script), *args])


def cmd_clarity(args: list[str]) -> int:
    if not args or args[0] in ("-h", "--help"):
        print(
            "Usage: ./scripts/adlc5 clarity <file_path> [--step-id ID]\n"
            "Stdout: JSON clarity report",
            file=sys.stderr if not args else sys.stdout,
        )
        return 0 if args and args[0] in ("-h", "--help") else 2
    script = SCRIPTS / "clarity-score.py"
    return run([sys.executable, str(script), *args])


def cmd_phase(args: list[str]) -> int:
    if args and args[0] == "apply":
        print(
            json.dumps(
                {
                    "status": "error",
                    "error": "phase_apply_unavailable",
                    "message": (
                        "advance-phase.sh is suggest-only (no safe mutate path). "
                        "Use ./scripts/adlc5 transition TARGET --feature NAME for canonical state."
                    ),
                }
            )
        )
        return 2
    script = SCRIPTS / "advance-phase.sh"
    err = require_exec(script)
    if err is not None:
        return err
    return run(["bash", str(script), *args])



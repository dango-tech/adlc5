    return run(["bash", str(script), *rest])


def cmd_completion(args, *, evidence=False):
    from lib.completion_evidence import transition, run_checks, fingerprint, append
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["check", "review", "approve", "build"] if evidence else None)
    parser.add_argument("--feature", required=True)
    parser.add_argument("--workspace", default=".")
    parser.add_argument("--file", help="review identity/disposition JSON or approval JSON")
    ns = parser.parse_args(args)
    workspace = Path(ns.workspace).resolve()
    try:
        if not evidence:
            result = transition(workspace, ns.feature, ns.action)
        elif ns.action == "check":
            result = run_checks(workspace, ns.feature)
            result["status"] = "ok" if result["stable"] and all(r["status"] == "pass" for r in result["results"] if r.get("required", True)) else "error"
        else:
            if not ns.file:
                raise ValueError("--file JSON required")
            result = json.loads(Path(ns.file).read_text())
            if not isinstance(result, dict):
                raise ValueError("record must be an object")
            if ns.action == "build":
                state = load_feature_state(workspace, ns.feature)
                if not state or state.get("current_step") != "implement-1-build":
                    raise ValueError("build records require implement-1-build")
                ids = result.get("story_ids")
                stories = (state.get("tasks") or {}).get("stories", [])
                from lib.policies_load import load_policies, profile_name
                if not isinstance(ids, list) or not ids and (stories or profile_name(load_policies(workspace, ns.feature)) != "tiny"):
                    raise ValueError("build record requires story_ids; empty allowed only for tiny without stories")
                if set(ids) - {s.get("id") for s in stories}:
                    raise ValueError("unknown story ID")
                for story in stories:
                    if story.get("id") in ids:
                        story["status"] = "implementation_complete"
                saved = set_feature_state(workspace, ns.feature, patch={"tasks": {"stories": stories}}, operation="transition")
                if saved["status"] != "ok":
                    raise ValueError(str(saved))
            elif ns.action == "review":
                state = load_feature_state(workspace, ns.feature)
                if not state or state.get("current_stage") != "implement":
                    raise ValueError("review requires Implement stage")
                for key in ("coder_session_id", "verifier_session_id", "coder_model_id", "verifier_model_id", "disposition"):
                    if not isinstance(result.get(key), str) or not result[key]:
                        raise ValueError("missing " + key)
                if result["disposition"] not in ("pass", "reject") or not isinstance(result.get("blocking_findings", []), list):
                    raise ValueError("invalid review disposition/findings")
            else:
                from lib.state_v2 import is_human_approver
                state = load_feature_state(workspace, ns.feature)
                approval_type = result.get("type")
                allowed = {"type", "approved_by", "decision", "reason"}
                if approval_type == "deploy_approval":
                    allowed.add("environment")
                if approval_type == "anchor_relock_approval":
                    allowed.update(("acceptance_id", "from_sha256", "to_sha256"))
                if set(result) - allowed:
                    raise ValueError("unknown approval fields: " + ", ".join(sorted(set(result) - allowed)))
                decision = result.get("decision", "approve")
                if decision not in ("approve", "reject"):
                    raise ValueError("approval decision must be approve or reject")
                result["decision"] = decision
                if approval_type not in ("pr_approval", "deploy_approval", "anchor_relock_approval", "verifier_waiver") or not is_human_approver(result.get("approved_by")):
                    raise ValueError("scoped approval type and human provenance label required; local unauthenticated attestation")
                allowed_stages = ("tasks", "implement") if approval_type == "anchor_relock_approval" else ("implement",)
                if not state or state.get("current_stage") not in allowed_stages:
                    raise ValueError("approval incompatible with current stage")
                if approval_type == "anchor_relock_approval":
                    import re
                    if not isinstance(result.get("acceptance_id"), str) or not result["acceptance_id"]:
                        raise ValueError("anchor relock requires acceptance_id")
                    if any(not isinstance(result.get(key), str) or not re.fullmatch(r"[0-9a-f]{64}", result[key]) for key in ("from_sha256", "to_sha256")):
                        raise ValueError("anchor relock requires from_sha256 and to_sha256")
                if approval_type == "verifier_waiver" and not result.get("reason"):
                    raise ValueError("verifier waiver requires reason; mandatory fresh completion review still applies")
                if approval_type == "deploy_approval":
                    if not isinstance(result.get("environment"), str) or not result["environment"].strip():
                        raise ValueError("deploy approval requires nonempty environment scope")
                    pr = (state.get("implement") or {}).get("pr") or {}
                    if state.get("stage_status", {}).get("implement") != "completed" or not (pr.get("url") and (pr.get("published") is True or pr.get("status") == "completed")):
                        raise ValueError("deploy approval requires completed Implement and published PR URL")
            result.update(kind={"review": "review", "approve": "approval", "build": "build"}[ns.action], fingerprint=fingerprint(workspace, ns.feature))
            append(workspace, ns.feature, result)
            if ns.action == "approve":
                # Anchor/deployment legacy readers consume history; freshness still comes from ledger.
                history = list((state.get("clarity") or {}).get("history") or [])
                history.append(result)
                saved = set_feature_state(workspace, ns.feature, patch={"clarity": {"history": history}}, operation="transition")
                if saved["status"] != "ok":
                    raise ValueError(str(saved))
            result = {"status": "ok"}
        if evidence and ns.action in ("check", "review"):
            from lib.completion_evidence import completion_checks
            state = load_feature_state(workspace, ns.feature)
            if state and all(c["status"] == "pass" for c in completion_checks(workspace, ns.feature, approval=False)):
                stories = (state.get("tasks") or {}).get("stories", [])
                for story in stories:
                    if story.get("status") == "implementation_complete":
                        story["status"] = "verified"
                from lib.completion_evidence import config
                implementation = {"verification": {"status": "completed"}}
                if any(c["id"] == "integration" and c.get("required", True) for c in config(workspace, ns.feature)):
                    implementation["integration"] = {"status": "completed"}
                saved = set_feature_state(workspace, ns.feature, patch={"tasks": {"stories": stories}, "implement": implementation}, operation="transition")
                if saved["status"] != "ok":
                    raise ValueError(str(saved))
        print(json.dumps(result, indent=2))
        return 0 if result.get("status") == "ok" else 2
    except (ValueError, TypeError, KeyError, OSError, subprocess.CalledProcessError) as exc:
        print(json.dumps({"status": "error", "message": str(exc)}))
        return 2


def cmd_version(_args: list[str]) -> int:
    print(f"adlc5 {read_version()}")
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        usage()
        return 0
    if argv[0] in ("--version", "-V"):
        return cmd_version([])

    command, rest = argv[0], argv[1:]
    if command not in COMMANDS:
        print(f"ERROR: unknown command: {command}", file=sys.stderr)
        usage(sys.stderr)
        return 2

    if command != "version" and not any(a in ("-h", "--help") for a in rest):
        for value in _workspace_args(rest):
            problem = check_workspace(ROOT, resolve_workspace(value))
            if problem:
                print(f"ERROR: {problem}", file=sys.stderr)
                return 2

    dispatch = {
        "transition": cmd_completion,
        "evidence": lambda args: cmd_completion(args, evidence=True),
        "gate": cmd_gate,
        "pack": cmd_pack,
        "clarity": cmd_clarity,
        "phase": cmd_phase,
        "pilot": cmd_pilot,
        "state": cmd_state,
        "anchors": cmd_anchors,
        "repo-spec": cmd_repo_spec,
        "repo-index": cmd_repo_index,
        "resolve-model": cmd_resolve_model,
        "cleanup-features": cmd_cleanup_features,
        "feature": cmd_feature,
        "usage": cmd_usage,
        "patterns": cmd_patterns,
        "spec-lint": cmd_spec_lint,
        "verify-story": cmd_verify_story,
        "version": cmd_version,
    }
    return dispatch[command](rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

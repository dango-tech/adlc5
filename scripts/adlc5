def _state_help(stream=sys.stdout) -> None:
    print(
        """Usage:
  ./scripts/adlc5 state get --feature NAME [--workspace DIR]
  ./scripts/adlc5 state set --feature NAME [--workspace DIR] (--patch JSON | --file PATH) [--replace] [--dry-run]

state set changes metadata only; protected progression/results require transition or evidence.
state repair --reason TEXT is audited recovery and cannot mint verification or approval.
state set merges --patch/--file into existing state.json (default), validates against
core/state-schema.json, then atomically writes. Invalid patches leave state untouched.
--replace requires a full document (still schema-validated; feature/schema_version locked).
""",
        file=stream,
        end="",
    )


def cmd_state_get(rest: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="adlc5 state get", add_help=True)
    parser.add_argument("--feature", required=True)
    parser.add_argument("--workspace", default=".")
    try:
        ns = parser.parse_args(rest)
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else 2
        return code if code else 0

    workspace = Path(ns.workspace).resolve()
    path = feature_state_path(workspace, ns.feature)

    def path_display() -> str:
        try:
            return str(path.relative_to(workspace))
        except ValueError:
            return str(path)

    data = load_feature_state(workspace, ns.feature)
    if data is None:
        err = "state_not_found" if not path.is_file() else "invalid_json"
        print(json.dumps({"status": "error", "error": err, "path": path_display()}))
        return 2

    print(json.dumps(data, indent=2))
    return 0


def cmd_state_set(rest: list[str], *, repair=False) -> int:
    parser = argparse.ArgumentParser(prog="adlc5 state set", add_help=True)
    parser.add_argument("--feature", required=True)
    parser.add_argument("--workspace", default=".")
    parser.add_argument("--patch", default=None, help="JSON object merged into existing state")
    parser.add_argument("--file", dest="file_path", default=None, help="JSON file (patch or replace)")
    parser.add_argument(
        "--replace",
        action="store_true",
        help="Replace entire state with --file/--patch document (not merge)",
    )
    parser.add_argument("--dry-run", action="store_true", help="Validate only; do not write")
    parser.add_argument("--reason", default=None)
    try:
        ns = parser.parse_args(rest)
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else 2
        return code if code else 0

    if (ns.patch is None) == (ns.file_path is None):
        print(
            json.dumps(
                {
                    "status": "error",
                    "error": "usage",
                    "message": "provide exactly one of --patch or --file",
                }
            )
        )
        return 2

    try:
        if ns.file_path is not None:
            raw = Path(ns.file_path).read_text(encoding="utf-8")
        else:
            raw = ns.patch
        payload = json.loads(raw)
    except (OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"status": "error", "error": "invalid_json", "message": str(exc)}))
        return 2

    if not isinstance(payload, dict):
        print(json.dumps({"status": "error", "error": "invalid_payload", "message": "JSON must be an object"}))
        return 2

    workspace = Path(ns.workspace).resolve()
    if repair and not ns.reason:
        print(json.dumps({"status": "error", "error": "repair_reason_required"}))
        return 2
    if repair and not ns.dry_run:
        from lib.completion_evidence import append
        append(workspace, ns.feature, {"kind": "repair_requested", "reason": ns.reason, "patch": payload})
    if ns.replace:
        result = set_feature_state(
            workspace, ns.feature, replace=payload, dry_run=ns.dry_run, operation="repair" if repair else "metadata"
        )
    else:
        result = set_feature_state(
            workspace, ns.feature, patch=payload, dry_run=ns.dry_run, operation="repair" if repair else "metadata"
        )

    # Keep stdout lean on success: status/path (+ dry_run); include errors on failure
    if result.get("status") == "ok":
        out = {"status": "ok", "path": result["path"]}
        if result.get("dry_run"):
            out["dry_run"] = True
        print(json.dumps(out, indent=2))
        return 0

    print(json.dumps(result, indent=2))
    return 2


def cmd_state(args: list[str]) -> int:
    if not args or args[0] in ("-h", "--help"):
        _state_help(sys.stdout if args else sys.stderr)
        return 0 if args and args[0] in ("-h", "--help") else 2

    sub, rest = args[0], args[1:]
    if sub == "get":
        return cmd_state_get(rest)
    if sub == "set":
        return cmd_state_set(rest)
    if sub == "repair":
        return cmd_state_set(rest, repair=True)
    print(f"ERROR: unknown state subcommand: {sub}", file=sys.stderr)
    _state_help(sys.stderr)
    return 2


def read_anchor_ref(workspace: Path, feature: str) -> str | None:
    proc = subprocess.run(
        ["git", "-C", str(workspace), "rev-parse", "--verify", "--quiet", f"refs/adlc5/anchors/{feature}"],
        capture_output=True,
        text=True,
    )
    return proc.stdout.strip() if proc.returncode == 0 else None


def restore_anchor_trust(
    workspace: Path,
    feature: str,
    manifest: Path,
    previous_manifest: bytes | None,
    previous_ref: str | None,
) -> None:
    if previous_manifest is None:
        manifest.unlink(missing_ok=True)
    else:
        manifest.write_bytes(previous_manifest)
    ref = f"refs/adlc5/anchors/{feature}"
    command = ["git", "-C", str(workspace), "update-ref", ref, previous_ref] if previous_ref else [
        "git", "-C", str(workspace), "update-ref", "-d", ref
    ]
    subprocess.run(command, capture_output=True, text=True, check=False)


def cmd_anchors(args: list[str]) -> int:
    if not args or args[0] not in ("lock", "check"):
        print("Usage: ./scripts/adlc5 anchors lock|check --feature NAME [--workspace DIR]", file=sys.stderr)
        return 2

    action, rest = args[0], args[1:]
    checker = SCRIPTS / "tasks" / "check-anchors.py"
    if action == "check":
        return run([sys.executable, str(checker), action, *rest])

    parser = argparse.ArgumentParser(prog="adlc5 anchors lock", add_help=False)
    parser.add_argument("--feature", required=True)
    parser.add_argument("--workspace", default=".")
    try:
        ns, unknown = parser.parse_known_args(rest)
    except SystemExit:
        return 2
    if unknown:
        print(f"ERROR: unknown arguments: {' '.join(unknown)}", file=sys.stderr)
        return 2

    workspace = Path(ns.workspace).resolve()
    manifest = workspace / ".adlc5" / ns.feature / "acceptance-lock.json"
    previous_manifest = manifest.read_bytes() if manifest.is_file() else None
    previous_ref = read_anchor_ref(workspace, ns.feature)
    proc = subprocess.run(
        [sys.executable, str(checker), "lock", "--feature", ns.feature, "--workspace", str(workspace)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        print(proc.stdout, end="")
        return int(proc.returncode)
    try:
        report = json.loads(proc.stdout)
        result = set_feature_state(workspace, ns.feature, patch=report["patch"])
    except Exception as exc:
        result = {"status": "error", "error": "invalid_anchor_output", "message": str(exc)}
    if result.get("status") != "ok":
        restore_anchor_trust(workspace, ns.feature, manifest, previous_manifest, previous_ref)
        print(json.dumps(result, indent=2))
        return 2
    report["applied"] = True
    print(json.dumps(report, indent=2))
    return 0


def cmd_cleanup_features(args: list[str]) -> int:
    script = SCRIPTS / "cleanup-features.sh"
    err = require_exec(script)
    if err is not None:
        return err
    return run(["bash", str(script), *args])


def cmd_repository_context(area: str, args: list[str]) -> int:
    allowed = {
        "repo-spec": {"init", "reconcile", "validate"},
        "repo-index": {"build", "refresh", "check"},
    }
    if not args or args[0] in ("-h", "--help"):
        actions = "|".join(sorted(allowed[area]))
        print(f"Usage: ./scripts/adlc5 {area} {actions} [--workspace DIR]")
        return 0 if args else 2
    if args[0] not in allowed[area]:
        print(f"ERROR: unknown {area} action: {args[0]}", file=sys.stderr)
        return 2
    script = SCRIPTS / "repository-context.py"
    if not script.is_file():
        print(f"ERROR: missing: {script}", file=sys.stderr)
        return 2
    return run([sys.executable, str(script), area, *args])


def cmd_repo_spec(args: list[str]) -> int:
    return cmd_repository_context("repo-spec", args)


def cmd_repo_index(args: list[str]) -> int:
    return cmd_repository_context("repo-index", args)


def _feature_help(stream=sys.stdout) -> None:
    print(
        """Usage:
  ./scripts/adlc5 feature summarize --feature-dir PATH [--workspace DIR] [--dry-run]

Writes OKF v0.2 Feature card (FEATURE.md) from state.json + artifact heads.
Also upserts .adlc5/_archive/index.md when path is under _archive/, and mirrors
to wiki/concepts/feature-{name}.md when wiki/ exists.
""",
        file=stream,
        end="",
    )


def cmd_feature(args: list[str]) -> int:
    if not args or args[0] in ("-h", "--help"):
        _feature_help(sys.stdout if args else sys.stderr)
        return 0 if args and args[0] in ("-h", "--help") else 2

    sub, rest = args[0], args[1:]
    if sub != "summarize":
        print(f"ERROR: unknown feature subcommand: {sub}", file=sys.stderr)
        _feature_help(sys.stderr)
        return 2

    script = SCRIPTS / "memory" / "summarize-feature-okf.py"
    if not script.is_file():
        print(f"ERROR: missing: {script}", file=sys.stderr)
        return 2
    return run([sys.executable, str(script), *rest])


def _usage_help(stream=sys.stdout) -> None:
    print(
        """Usage:
  ./scripts/adlc5 usage record --feature NAME [--workspace DIR] --model-id ID
      [--platform NAME] [--tier TIER] [--stage STAGE] [--step STEP]
      [--source self_reported|transcript|api]
      [--input-tokens N] [--output-tokens N] [--thinking-tokens N]
      [--cache-creation-tokens N] [--cache-read-tokens N]
      [--cache-5m-tokens N] [--cache-1h-tokens N] [--total-tokens N]
      [--extra-json JSON] [--note TEXT]
  ./scripts/adlc5 usage summary --feature NAME [--workspace DIR] [--format json|markdown]
  ./scripts/adlc5 usage summary --feature-dir PATH [--format json|markdown]
  ./scripts/adlc5 usage fleet --workspace DIR [--active-only] [--format json|markdown]
  ./scripts/adlc5 usage cursor sync [--workspace DIR] [--force]
  ./scripts/adlc5 usage cursor sync-all [--force]
  ./scripts/adlc5 usage cursor sync-cloud [--workspace DIR] [--force]
  ./scripts/adlc5 usage cursor sync-cloud-all [--force]
  ./scripts/adlc5 usage cursor cloud --feature NAME --agent-id ID --model-id ID [--run-id ID]

`sync`/`sync-all` reconcile IDE Composer sessions via the Cursor Admin API
(`/teams/filtered-usage-events`) — requires a Team or Org Admin API key, not
available on every account. `sync-cloud`/`sync-cloud-all` reconcile Cloud
Agent runs via `/v1/agents` + `/v1/agents/{id}/usage` — works with a personal
User API key. Bind an agent the same way as an IDE conversation:
`usage cursor bind --feature NAME --conversation-id bc-...`.

Appends model + token usage to .adlc5/{feature}/memory/usage-ledger.jsonl (best-effort,
self-reported by the calling agent/skill — not a billing reconciliation). stage/step
default to state.json current_stage/current_step when omitted. Carried into the archive
by cleanup-features.sh (mv moves memory/); embedded as a Usage section in FEATURE.md
and written as usage-summary.json when `adlc5 feature summarize` / `--archive` runs.

`fleet` rolls totals up across every feature under a workspace's .adlc5/ — active
and archived (--active-only excludes .adlc5/_archive/) — with by_model/by_stage/
by_feature breakdowns, for a workspace-wide token/cost view `summary` can't give
(it's scoped to one feature).
""",
        file=stream,
        end="",
    )


def cmd_usage(args: list[str]) -> int:
    if not args or args[0] in ("-h", "--help"):
        _usage_help(sys.stdout if args else sys.stderr)
        return 0 if args and args[0] in ("-h", "--help") else 2

    sub, rest = args[0], args[1:]
    if sub == "cursor":
        script = SCRIPTS / "cursor-usage.py"
        if not script.is_file():
            print(f"ERROR: missing: {script}", file=sys.stderr)
            return 2
        return run([sys.executable, str(script), *rest])

    if sub not in ("record", "summary", "fleet"):
        print(f"ERROR: unknown usage subcommand: {sub}", file=sys.stderr)
        _usage_help(sys.stderr)
        return 2

    script = SCRIPTS / "memory" / "usage-ledger.py"
    if not script.is_file():
        print(f"ERROR: missing: {script}", file=sys.stderr)
        return 2
    return run([sys.executable, str(script), sub, *rest])



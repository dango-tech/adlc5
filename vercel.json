{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && uv venv .venv-docs && uv pip install --python .venv-docs/bin/python -r requirements-docs.txt",
  "buildCommand": ".venv-docs/bin/python -m mkdocs build --strict && cp node_modules/@vercel/speed-insights/dist/index.mjs site/assets/speed-insights.mjs",
  "outputDirectory": "site",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
